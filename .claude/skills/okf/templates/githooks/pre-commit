#!/bin/sh
# okf pre-commit gate. Wiring varies per repo (local core.hooksPath, a chain from .git/hooks/pre-commit,
# or a global-hook chain point) — see DECISIONS.md or the bootstrap log entry for how it was installed HERE.
# Lint errors on wiki-touching commits BLOCK; code-without-wiki commits WARN only. Bypass once: --no-verify.
# PROJECT GATES: put your own checks in .okf/githooks/pre-commit.local (executable). It runs first and
# survives an /okf re-copy of this file.
[ -x .okf/githooks/pre-commit.local ] && { .okf/githooks/pre-commit.local || exit 1; }
[ -f .okf/okf-py.sh ] || exit 0
exec sh .okf/okf-py.sh pre-commit
